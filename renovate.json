{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>ublacklist/.github:renovate-config"],
  "enabledManagers": ["github-actions", "git-submodules", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["pipx run check-jsonschema==(?<currentValue>[^ ]+)"],
      "depNameTemplate": "check-jsonschema",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "Treat minor updates of Hugo and Hextra like majors: separate PRs, no automerge",
      "matchDepNames": ["hugo", "themes/hextra"],
      "matchCurrentVersion": "<1",
      "matchUpdateTypes": ["minor"],
      "groupName": null,
      "schedule": null,
      "automerge": false
    },
    {
      "description": "Look up Hextra on GitHub so minimumReleaseAge can apply",
      "matchDepNames": ["themes/hextra"],
      "overrideDatasource": "github-tags",
      "overridePackageName": "imfing/hextra",
      "minimumReleaseAge": "3 days"
    }
  ]
}
