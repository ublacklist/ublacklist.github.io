{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>ublacklist/.github:renovate-config"],
  "enabledManagers": ["github-actions", "git-submodules", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["pipx run check-jsonschema==(?<currentValue>[^ ]+)"],
      "depNameTemplate": "check-jsonschema",
      "datasourceTemplate": "pypi"
    }
  ]
}
